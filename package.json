{
  "name": "alexandre-sdd-portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:corpus": "npm run build --workspace @portfolio/interview-core",
    "build:api": "npm run build --workspace @portfolio/interview-api",
    "build": "npm run build:portfolio && npm run build:corpus && npm run build:api",
    "clean": "rm -rf apps/interview-api/dist packages/interview-core/dist packages/interview-core/generated",
    "dev:api": "npm run dev --workspace @portfolio/interview-api",
    "start": "npm run start --workspace @portfolio/interview-api",
    "test": "npm run test --workspace @portfolio/interview-core && npm run test --workspace @portfolio/interview-api && npm run test:frontend",
    "test:frontend": "node --test test/*.test.mjs",
    "build:portfolio": "node scripts/build-work.mjs",
    "test:browser": "node scripts/verify-portfolio.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.1",
    "playwright": "^1.65.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
